# API Configuration
# Environment mode: development | production
VITE_ENV=development

# Development API (local Django server)
VITE_API_URL_DEV=http://localhost:8000/api/v1

# Production API. Only read when MODE === 'production', i.e. by `npm run build`,
# never by `npm run dev` — so this belongs in .env.production (which sets it to
# the relative /api/v1 for local preview) or in the deploy platform's env vars.
# Setting it here leaks into local production builds and points them at the
# live deployment; that is exactly the bug .env.production now documents.
# VITE_API_URL_PROD=https://your-deployment/api/v1
