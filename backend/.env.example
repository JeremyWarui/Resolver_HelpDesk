# Copy to .env (gitignored) and adjust. Nothing here is a real secret.

SECRET_KEY=dev-only-not-a-secret

# Local development runs over http, and the refresh cookie is Secure whenever
# this is False. Leave it True locally or the session dies at the first refresh.
DEBUG=True

# Database: local PostgreSQL. Either set DATABASE_URL, which wins, or the five
# DB_* vars below.
#
#   DATABASE_URL=postgres://user:password@localhost:5432/resolver
#
# Windows, after installing PostgreSQL: the installer creates the `postgres`
# superuser and asks for its password. Create the database once with
#
#   & "C:\Program Files\PostgreSQL\17\bin\createdb.exe" -U postgres resolver
#
# Linux/macOS: a DB_HOST starting with "/" is a Unix socket directory, which
# means peer auth and no password to store. Create it once with
#
#   sudo -u postgres createuser --createdb "$USER"
#   createdb resolver
#
# Then `manage.py migrate` builds the schema and `manage.py seed` fills it.
# Never create tables by hand: the migrations are the schema.
DB_NAME=resolver
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# The seed refuses to run without this.
SEED_DEFAULT_PASSWORD=
