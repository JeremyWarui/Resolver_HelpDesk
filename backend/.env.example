# Copy to .env (gitignored) and adjust. Nothing here is a real secret.

SECRET_KEY=dev-only-not-a-secret

# Database. Either set DATABASE_URL (which wins, and is what Render provides)
# or the five DB_* vars below.
#
#   DATABASE_URL=postgres://user:password@host:5432/dbname
#
# A DB_HOST starting with "/" is a Unix socket directory, which means peer
# auth and no password to store — the default on Ubuntu when the Postgres role
# is named after your Unix user. Create it once with:
#
#   sudo systemctl start postgresql
#   sudo -u postgres createuser --createdb "$USER"
#   createdb resolver
#
# Then `manage.py migrate` builds the schema and `manage.py seed` fills it.
# Never create tables by hand — the migrations are the schema.
DB_NAME=resolver
DB_USER=your-unix-username
DB_PASSWORD=
DB_HOST=/var/run/postgresql
DB_PORT=5432
